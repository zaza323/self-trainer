# Supabase (public — تُقرأ في المتصفح)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase (server only — لا تُكشف للمتصفح أبدًا). يُستخدم لإنشاء حساب الطفل (ACC-3) فقط.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# الموقع (لروابط العودة بعد تسجيل الدخول عبر Google)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# قاعدة بيانات محلية لاختبارات RLS وتزامن الكتالوج (pnpm test:rls / pnpm config:sync)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/self_trainer_test

# الذكاء الاصطناعي (المرحلة 4) — المفتاح في الخادم فقط. بدونه يعمل كل شيء بالسلوك الثابت.
ANTHROPIC_API_KEY=
AI_MODEL_ID=claude-opus-5-5
AI_MODEL_ID_LIGHT=claude-sonnet-5-5
# AI_DISABLED=1  لتعطيل الذكاء الاصطناعي مؤقتًا (اختبار السقوط)

# المرحلة 6: Web Push (NOTIF-4) — ولّد المفاتيح بـ `pnpm vapid` ثم الصقها هنا. الخاص في الخادم فقط.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# سر الدورة المجدولة (/api/cron/tick) — Vercel Cron يرسله تلقائيًا كـ Authorization: Bearer
CRON_SECRET=

# المرحلة 8: القياس المجهّل (اختياري). بدون POSTHOG_KEY تُحفظ الأحداث في product_events فقط.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_SALT=change-me
