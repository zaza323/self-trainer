    }
  },
  "evidence_bridge": {
    "rule_weight": 0.5,
    "daily_cap_per_capability": 3,
    "rules": {
      "P1": {
        "type": "prediction_accuracy",
        "capability": "self_awareness",
        "source": "auto",
        "value": {
          "kind": "prediction_error",
          "tolerance": 1.0
        }
      },
      "P2": {
        "type": "distraction_response",
        "capability": "attention",
        "source": "self",
        "value": {
          "returned": 0.6,
          "ended_session": -0.2
        }
      },
      "P3": {
        "type": "recovery",
        "capability": "perseverance",
        "source": "auto",
        "min_postpones": 2,
        "value": 0.6
      },
      "P4": {
        "type": "strategy_fit",
        "capability": "planning",
        "source": "auto",
        "min_support_level": "L2_ask",
        "value": 0.5
      },
      "P5": {
        "type": "reflection_quality",
        "capability": "self_awareness",
        "source": "self",
        "requires_cancel_reason": true,
        "value": 0.5
      }
    },
