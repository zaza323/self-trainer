    "mission_selector":    { "model": "light", "max_output_tokens": 400,  "daily_calls_per_profile": 10, "streaming": false },
    "task_classifier":     { "model": "light", "max_output_tokens": 400,  "daily_calls_per_profile": 20, "streaming": false },
    "reflection_coach":    { "model": "main",  "max_output_tokens": 500,  "daily_calls_per_profile": 40, "streaming": false },
    "progress_narrator":   { "model": "light", "max_output_tokens": 300,  "daily_calls_per_profile": 10, "streaming": false },
    "companion_chat":      { "model": "main",  "max_output_tokens": 500,  "daily_calls_per_profile": 80, "streaming": true },
    "weekly_summary":      { "model": "light", "max_output_tokens": 600,  "daily_calls_per_profile": 2,  "streaming": false },
    "strategy_normalizer": { "model": "light", "max_output_tokens": 50,   "daily_calls_per_profile": 20, "streaming": false },
    "adaptation_advisor":  { "model": "main",  "max_output_tokens": 600,  "daily_calls_per_profile": 1,  "streaming": false },
